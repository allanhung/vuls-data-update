	"advisories": [
		{
			"content": {
				"id": "ALINUX4-SA-2026:0104",
				"title": "ALINUX4-SA-2026:0104: kernel security update (Important)",
				"description": "Package updates are available for Alibaba Cloud Linux 4 that fix the following vulnerabilities:\n\nCVE-2026-31431:\nIn the Linux kernel, the following vulnerability has been resolved:\ncrypto: algif_aead - Revert to operating out-of-place\nThis mostly reverts commit 72548b093ee3 except for the copying of\nthe associated data.\nThere is no benefit in operating in-place in algif_aead since the\nsource and destination come from different mappings.  Get rid of\nall the complexity added for in-place operation and just copy the\nAD directly.",
				"severity": [
					{
						"type": "vendor",
						"source": "alas.aliyun.com",
						"vendor": "Important"
					}
				],
